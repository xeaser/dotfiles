<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.psharma.homelab-publish</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/psharma/dotfiles/zsh/scripts/homelab-publish-ip</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>WatchPaths</key>
    <array>
        <string>/var/run/resolv.conf</string>
        <string>/Library/Preferences/SystemConfiguration/NetworkInterfaces.plist</string>
    </array>

    <key>StartInterval</key>
    <integer>300</integer>

    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>StandardOutPath</key>
    <string>/opt/homebrew/var/log/homelab-publish.log</string>

    <key>StandardErrorPath</key>
    <string>/opt/homebrew/var/log/homelab-publish.err</string>

    <key>WorkingDirectory</key>
    <string>/Users/psharma</string>
</dict>
</plist>
