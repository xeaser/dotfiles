{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/oh-my-opencode.schema.json",
  "agents": {
    "sisyphus": {
      "model": "amazon-bedrock/us.anthropic.claude-opus-4-8",
      "variant": "max"
    },
    "hephaestus": {
      "model": "amazon-bedrock/us.anthropic.claude-opus-4-8",
      "variant": "medium"
    },
    "oracle": {
      "model": "amazon-bedrock/us.anthropic.claude-opus-4-8",
      "variant": "high"
    },
    "librarian": {
      "model": "amazon-bedrock/us.anthropic.claude-sonnet-5"
    },
    "explore": {
      "model": "amazon-bedrock/us.anthropic.claude-sonnet-5"
    },
    "prometheus": {
      "model": "amazon-bedrock/us.anthropic.claude-opus-4-8",
      "variant": "max"
    },
    "metis": {
      "model": "amazon-bedrock/us.anthropic.claude-opus-4-8",
      "variant": "max"
    },
    "momus": {
      "model": "amazon-bedrock/us.anthropic.claude-opus-4-8",
      "variant": "medium"
    },
    "atlas": {
      "model": "amazon-bedrock/us.anthropic.claude-sonnet-5",
      "variant": "max"
    }
  },
  "disabled_hooks": [
    "anthropic-context-window-limit-recovery"
  ],
  "categories": {
    "visual-engineering": {
      "model": "amazon-bedrock/us.anthropic.claude-sonnet-5"
    },
    "ultrabrain": {
      "model": "amazon-bedrock/us.anthropic.claude-opus-4-8",
      "variant": "max"
    },
    "deep": {
      "model": "amazon-bedrock/us.anthropic.claude-opus-4-8",
      "variant": "medium"
    },
    "artistry": {
      "model": "amazon-bedrock/us.anthropic.claude-sonnet-5",
      "variant": "high"
    },
    "quick": {
      "model": "amazon-bedrock/us.anthropic.claude-sonnet-5"
    },
    "unspecified-low": {
      "model": "amazon-bedrock/us.anthropic.claude-sonnet-5"
    },
    "unspecified-high": {
      "model": "amazon-bedrock/us.anthropic.claude-opus-4-8",
      "variant": "max"
    },
    "writing": {
      "model": "amazon-bedrock/us.anthropic.claude-sonnet-5"
    }
  },
  "git_master": {
    "commit_footer": true,
    "include_co_authored_by": false,
    "git_env_prefix": "GIT_MASTER=1"
  }
}
