{
  "plugin": [
    "oh-my-openagent@latest",
    "@tarquinen/opencode-dcp@latest",
    "@nick-vi/opencode-type-inject",
    "opencode-pty",
    "opencode-wakatime",
    "opencode-helicone-session",
    "opencode-scheduler",
    "opencode-supermemory",
    // "openrtk",
    "@datadog/opencode-plugin"
  ],
  "instructions": [
    "~/.config/opencode/plugin/shell-strategy/shell_strategy.md",
    // "~/.config/opencode/plugin/openrtk/openrtk.md"
  ],
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "postgres": {
      "type": "local",
      "command": [
        "docker",
        "run",
        "-i",
        "--rm",
        "mcp/postgres",
        "postgresql://postgres:{env:POSTGRES_PASSWORD}@host.docker.internal:5432/{env:POSTGRES_DB}"
      ],
      "enabled": false
    },
    "postgres_rw": {
      "type": "local",
      "command": [
        "node",
        "/Users/psharma/.config/opencode/mcp/postgres-rw/index.js",
        "postgresql://postgres:{env:POSTGRES_PASSWORD}@localhost:5432/{env:POSTGRES_DB}"
      ],
      "enabled": false
    },
    "rovo": {
      "type": "remote",
      "url": "https://mcp.atlassian.com/v1/mcp",
      "enabled": true
    },
    "aws-knowledge": {
      "type": "remote",
      "url": "https://knowledge-mcp.global.api.aws",
      "enabled": true
    },
    "aws-mcp": {
      "type": "local",
      "command": [
        "uvx",
        "mcp-proxy-for-aws@1.6.4",
        "https://aws-mcp.us-east-1.api.aws/mcp",
        "--metadata",
        "AWS_REGION=us-east-1"
      ],
      "environment": {
        "AWS_PROFILE": "cb-factory"
      },
      "enabled": true
    },
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer {env:GITHUB_PAT}",
        "X-MCP-Insiders": "true"
      },
      "enabled": true
    },
    "jetbrains": {
      "type": "remote",
      "url": "http://localhost:64342/sse",
      "enabled": false
    },
    "jetbrains-pycharm": {
      "type": "remote",
      "url": "http://localhost:64343/sse",
      "enabled": false
    },
    "aifr-preprod": {
      "type": "remote",
      "url": "https://aifr.saas-preprod.beescloud.com/mcp",
      "headers": {
        "Authorization": "Bearer {env:AIFR_PREPROD_KEY}"
      },
      "enabled": false
    },
    "obsidian": {
      "type": "local",
      "command": [
        "npx",
        "obsidian-mcp-server"
      ],
      "environment": {
        "OBSIDIAN_API_KEY": "{env:OBSIDIAN_API_KEY}",
        "OBSIDIAN_BASE_URL": "http://127.0.0.1:27123",
        "OBSIDIAN_VERIFY_SSL": "false",
        "OBSIDIAN_ENABLE_CACHE": "true"
      },
      "enabled": true
    },
    "slack": {
      "type": "remote",
      "url": "https://mcp.slack.com/mcp",
      "oauth": {
        "clientId": "1601185624273.8899143856786",
        // "callbackPort": 3118
      },
      "enabled": false
    },
    "codegraphcontext": {
      "type": "local",
      "command": [
        "/Users/psharma/dotfiles/codegraphcontext/start-mcp.sh"
      ],
      "environment": {
        "DEFAULT_DATABASE": "neo4j",
        "NEO4J_URI": "bolt://localhost:7687",
        "NEO4J_USERNAME": "neo4j",
        "NEO4J_PASSWORD": "{env:NEO4J_PASSWORD}"
      },
      "enabled": true
    },
    "superset": {
      "type": "remote",
      "url": "https://api.superset.sh/mcp",
      "oauth": {}
    },
    "unify": {
      "type": "remote",
      "url": "https://mcp.cloudbees.io/v1/mcp",
      "oauth": {
        "clientId": "public-mcp-client",
        "redirectUri": "http://localhost:19876/mcp/oauth/callback"
      },
      "enabled": false
    },
    "unify-preprod": {
      "type": "remote",
      "url": "https://mcp.saas-preprod.beescloud.com/v1/mcp",
      "oauth": {
        "clientId": "public-mcp-client",
        "redirectUri": "http://localhost:19876/mcp/oauth/callback"
      },
      "enabled": false
    },
    "datadog-preprod": {
      "type": "remote",
      "url": "https://mcp.datadoghq.com/api/unstable/mcp-server/mcp?toolsets=all",
      "enabled": false
    },
    "datadog": {
      "type": "remote",
      "url": "https://mcp.datadoghq.com/api/unstable/mcp-server/mcp?toolsets=all",
      "enabled": false
    },
    "postman": {
      "type": "remote",
      "url": "https://mcp.postman.com/mcp?config=full",
      "headers": {
        "Authorization": "Bearer {env:POSTMAN_API_KEY}"
      },
      "enabled": false
    },
    "grafana": {
      "type": "local",
      "command": [
        "docker",
        "run",
        "--rm",
        "-i",
        "-e",
        "GRAFANA_URL",
        "-e",
        "GRAFANA_API_KEY",
        "mcp/grafana",
        "-t",
        "stdio"
      ],
      "environment": {
        "GRAFANA_URL": "http://host.docker.internal:3001",
        "GRAFANA_API_KEY": "{env:GRAFANA_API_KEY}"
      },
      "enabled": false
    },
    // Bedrock computer use driving THIS Mac's real desktop via Quartz.
    // Requires Screen Recording + Accessibility granted to the terminal app that
    // launches opencode. Screenshots are downscaled to 1280 wide and coordinates are
    // mapped back to logical points (2x Retina), so clicks land where intended.
    // Interpreter is a uv-managed venv, so `brew upgrade python` cannot break it.
    // Rebuild deps with: cd ~/.config/opencode/mcp/computer-use && uv sync
    // Opus 5 does NOT support computer use; Sonnet 5 and Opus 4.8 do.
    "computer-use": {
      "type": "local",
      "command": [
        "~/.config/opencode/mcp/computer-use/run.sh"
      ],
      "environment": {
        "AWS_PROFILE": "cb-bedrock",
        "AWS_REGION": "us-east-1",
        "CU_BACKEND": "macos",
        "CU_MODEL_ID": "us.anthropic.claude-sonnet-5",
        "CU_DISPLAY_WIDTH": "1280",
        "CU_MAX_STEPS": "40",
        "CU_KEEP_SCREENSHOTS": "3",
        "CU_ENABLE_BASH": "1"
      },
      "enabled": false
    },
    // Same server pointed at a throwaway Linux desktop in a container instead of the
    // Mac. Kept for disposable/risky automation. Enable this and it will start the
    // container itself; build the image once with:
    //   docker build -t opencode-computer-use:latest ~/.config/opencode/mcp/computer-use/sandbox
    "computer-use-sandbox": {
      "type": "local",
      "command": [
        "~/.config/opencode/mcp/computer-use/run.sh"
      ],
      "environment": {
        "AWS_PROFILE": "cb-bedrock",
        "AWS_REGION": "us-east-1",
        "CU_BACKEND": "sandbox",
        "CU_MODEL_ID": "us.anthropic.claude-sonnet-5",
        "CU_CONTROL_PORT": "8787",
        "CU_VNC_PORT": "5900",
        "CU_DISPLAY_WIDTH": "1280",
        "CU_DISPLAY_HEIGHT": "800",
        "CU_MAX_STEPS": "40",
        "CU_KEEP_SCREENSHOTS": "3"
      },
      "enabled": false
    }
  },
  "provider": {
    "amazon-bedrock": {
      "options": {
        "region": "us-east-1",
        "profile": "cb-bedrock"
      },
      "whitelist": [
        "us.anthropic.claude-opus-5",
        "us.anthropic.claude-opus-4-8",
        "us.anthropic.claude-sonnet-5",
        "us.anthropic.claude-haiku-4-5-20251001-v1:0"
      ]
    },
    // "bedrock-codex": {
    //   "npm": "@ai-sdk/amazon-bedrock",
    //   "name": "Bedrock Codex (Runtime)",
    //   "options": {
    //     "region": "us-east-1",
    //     "baseURL": "http://localhost:8898",
    //     "accessKeyId": "dummy",
    //     "secretAccessKey": "dummy"
    //   },
    //   "models": {
    //     "openai.gpt-oss-120b-1:0": { "name": "GPT-OSS 120B (Runtime)" },
    //     "deepseek.v3.2": { "name": "DeepSeek V3.2 (Runtime)" },
    //     "qwen.qwen3-coder-next": { "name": "Qwen3 Coder Next (Runtime)" },
    //     "minimax.minimax-m2.5": { "name": "MiniMax M2.5 (Runtime)" },
    //     "moonshotai.kimi-k2.5": { "name": "Kimi K2.5 (Runtime)" },
    //     "zai.glm-5": { "name": "GLM-5 (Runtime)" },
    //     "mistral.devstral-2-123b": { "name": "Devstral 2 123B (Runtime)" },
    //     "qwen.qwen3-next-80b-a3b": { "name": "Qwen3 Next 80B (Runtime)" },
    //     "mistral.mistral-large-3-675b-instruct": { "name": "Mistral Large 3 (Runtime)" },
    //     "nvidia.nemotron-super-3-120b": { "name": "Nemotron Super 3 120B (Runtime)" },
    //     "zai.glm-4.7": { "name": "GLM-4.7 (Runtime)" },
    //     "moonshot.kimi-k2-thinking": { "name": "Kimi K2 Thinking (Runtime)" },
    //     "amazon.nova-pro-v1:0": { "name": "Nova Pro (Runtime)", "limit": { "context": 300000, "output": 10000 } },
    //     "us.amazon.nova-2-lite-v1:0": { "name": "Nova 2 Lite (Runtime)" },
    //     "google.gemma-3-27b-it": { "name": "Gemma 3 27B (Runtime)" }
    //   }
    // },
    "bedrock-mantle": {
      "npm": "@ai-sdk/openai",
      "name": "Bedrock Mantle (codex)",
      "options": {
        "baseURL": "http://localhost:8899/openai/v1",
        "apiKey": "dummy"
      },
      "models": {
        "gpt-5.6-sol": { "name": "GPT-5.6 Sol (Mantle)" , "id": "openai.gpt-5.6-sol" },
        "gpt-5.6-luna": { "name": "GPT-5.6 Luna (Mantle)", "id": "openai.gpt-5.6-luna" },
        "gpt-5.6-terra": { "name": "GPT-5.6 Terra (Mantle)", "id": "openai.gpt-5.6-terra" },
        "gpt-5.5": { "name": "GPT-5.5 (Mantle)", "id": "openai.gpt-5.5" },
      }
    }
  }
}
