{
  "plugin": [
    "oh-my-openagent@latest",
    "@tarquinen/opencode-dcp@latest",
    "@nick-vi/opencode-type-inject",
    "opencode-pty",
    "opencode-wakatime",
    "opencode-helicone-session",
    "opencode-scheduler",
    "opencode-supermemory",
    "openrtk",
    "@datadog/opencode-plugin"
  ],
  "instructions": [
    "~/.config/opencode/plugin/shell-strategy/shell_strategy.md",
    "~/.config/opencode/plugin/openrtk/openrtk.md"
  ],
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "postgres": {
      "type": "local",
      "command": [
        "docker",
        "run",
        "-i",
        "--rm",
        "mcp/postgres",
        "postgresql://postgres:{env:POSTGRES_PASSWORD}@host.docker.internal:5432/{env:POSTGRES_DB}"
      ],
      "enabled": false
    },
    "postgres_rw": {
      "type": "local",
      "command": [
        "node",
        "/Users/psharma/.config/opencode/mcp/postgres-rw/index.js",
        "postgresql://postgres:{env:POSTGRES_PASSWORD}@localhost:5432/{env:POSTGRES_DB}"
      ],
      "enabled": false
    },
    "rovo": {
      "type": "remote",
      "url": "https://mcp.atlassian.com/v1/mcp",
      "enabled": true
    },
    "aws-knowledge": {
      "type": "remote",
      "url": "https://knowledge-mcp.global.api.aws",
      "enabled": true
    },
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer {env:GITHUB_PAT}",
        "X-MCP-Insiders": "true"
      },
      "enabled": true
    },
    "jetbrains": {
      "type": "remote",
      "url": "http://localhost:64342/sse",
      "enabled": false
    },
    "jetbrains-pycharm": {
      "type": "remote",
      "url": "http://localhost:64343/sse",
      "enabled": false
    },
    "aifr-preprod": {
      "type": "remote",
      "url": "https://aifr.saas-preprod.beescloud.com/mcp",
      "headers": {
        "Authorization": "Bearer {env:AIFR_PREPROD_KEY}"
      },
      "enabled": false
    },
    "obsidian": {
      "type": "local",
      "command": [
        "npx",
        "obsidian-mcp-server"
      ],
      "environment": {
        "OBSIDIAN_API_KEY": "{env:OBSIDIAN_API_KEY}",
        "OBSIDIAN_BASE_URL": "http://127.0.0.1:27123",
        "OBSIDIAN_VERIFY_SSL": "false",
        "OBSIDIAN_ENABLE_CACHE": "true"
      },
      "enabled": true
    },
    "slack": {
      "type": "remote",
      "url": "https://mcp.slack.com/mcp",
      "oauth": {
        "clientId": "1601185624273.8899143856786",
        // "callbackPort": 3118
      },
      "enabled": false
    },
    "codegraphcontext": {
      "type": "local",
      "command": [
        "/Users/psharma/dotfiles/codegraphcontext/start-mcp.sh"
      ],
      "environment": {
        "DEFAULT_DATABASE": "neo4j",
        "NEO4J_URI": "bolt://localhost:7687",
        "NEO4J_USERNAME": "neo4j",
        "NEO4J_PASSWORD": "{env:NEO4J_PASSWORD}"
      },
      "enabled": true
    },
    "superset": {
      "type": "remote",
      "url": "https://api.superset.sh/api/agent/mcp",
      "oauth": {}
    },
    "unify": {
      "type": "remote",
      "url": "https://mcp.cloudbees.io/v1/mcp",
      "oauth": {
        "clientId": "public-mcp-client",
        "redirectUri": "http://localhost:19876/mcp/oauth/callback"
      },
      "enabled": false
    },
    "unify-preprod": {
      "type": "remote",
      "url": "https://mcp.saas-preprod.beescloud.com/v1/mcp",
      "oauth": {
        "clientId": "public-mcp-client",
        "redirectUri": "http://localhost:19876/mcp/oauth/callback"
      },
      "enabled": false
    },
    "datadog-preprod": {
      "type": "remote",
      "url": "https://mcp.datadoghq.com/api/unstable/mcp-server/mcp?toolsets=all",
      "enabled": false
    },
    "datadog": {
      "type": "remote",
      "url": "https://mcp.datadoghq.com/api/unstable/mcp-server/mcp?toolsets=all",
      "enabled": false
    },
    "postman": {
      "type": "remote",
      "url": "https://mcp.postman.com/mcp?config=full",
      "headers": {
        "Authorization": "Bearer {env:POSTMAN_API_KEY}"
      },
      "enabled": false
    },
    "grafana": {
      "type": "local",
      "command": [
        "docker",
        "run",
        "--rm",
        "-i",
        "-e",
        "GRAFANA_URL",
        "-e",
        "GRAFANA_API_KEY",
        "mcp/grafana",
        "-t",
        "stdio"
      ],
      "environment": {
        "GRAFANA_URL": "http://host.docker.internal:3001",
        "GRAFANA_API_KEY": "{env:GRAFANA_API_KEY}"
      },
      "enabled": false
    }
  },
  "provider": {
    "amazon-bedrock": {
      "options": {
        "region": "us-east-1",
        "profile": "cb-bedrock"
      },
      "whitelist": [
        "us.anthropic.claude-opus-4-8",
        "us.anthropic.claude-sonnet-5",
        "us.anthropic.claude-haiku-4-5-20251001-v1:0"
      ]
    },
    "bedrock-codex": {
      "npm": "@ai-sdk/amazon-bedrock",
      "name": "Bedrock Codex (Runtime)",
      "options": {
        "region": "us-east-1",
        "baseURL": "http://localhost:8898",
        "accessKeyId": "dummy",
        "secretAccessKey": "dummy"
      },
      "models": {
        "openai.gpt-oss-120b-1:0": { "name": "GPT-OSS 120B (Runtime)" },
        "deepseek.v3.2": { "name": "DeepSeek V3.2 (Runtime)" },
        "qwen.qwen3-coder-next": { "name": "Qwen3 Coder Next (Runtime)" },
        "minimax.minimax-m2.5": { "name": "MiniMax M2.5 (Runtime)" },
        "moonshotai.kimi-k2.5": { "name": "Kimi K2.5 (Runtime)" },
        "zai.glm-5": { "name": "GLM-5 (Runtime)" },
        "mistral.devstral-2-123b": { "name": "Devstral 2 123B (Runtime)" },
        "qwen.qwen3-next-80b-a3b": { "name": "Qwen3 Next 80B (Runtime)" },
        "mistral.mistral-large-3-675b-instruct": { "name": "Mistral Large 3 (Runtime)" },
        "nvidia.nemotron-super-3-120b": { "name": "Nemotron Super 3 120B (Runtime)" },
        "zai.glm-4.7": { "name": "GLM-4.7 (Runtime)" },
        "moonshot.kimi-k2-thinking": { "name": "Kimi K2 Thinking (Runtime)" },
        "amazon.nova-pro-v1:0": { "name": "Nova Pro (Runtime)", "limit": { "context": 300000, "output": 10000 } },
        "us.amazon.nova-2-lite-v1:0": { "name": "Nova 2 Lite (Runtime)" },
        "google.gemma-3-27b-it": { "name": "Gemma 3 27B (Runtime)" }
      }
    },
    "bedrock-mantle": {
      "npm": "@ai-sdk/openai",
      "name": "Bedrock Mantle (codex)",
      "options": {
        "baseURL": "http://localhost:8899/openai/v1",
        "apiKey": "dummy"
      },
      "models": {
        "openai.gpt-5.6-sol": { "name": "GPT-5.6 Sol (Mantle)" }
      }
    }
  }
}
