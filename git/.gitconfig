[core]
	excludesFile = ~/.gitignore_global
[init]
	templateDir = /Users/psharma/.git-templates/git-secrets
[secrets]
	providers = opscore security run git-secrets-provider -q
[gpg]
	format = ssh
[user]
	signingkey = /Users/psharma/.ssh/id_ed25519.pub
	name = CloudBees Factory Agent
	email = factory-agent@cloudbees.com
[commit]
	gpgsign = true
[credential "https://github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
[safe]
	directory = /var/folders/h9/057c6v717j975wpgy_gnh_500000gn/T/opencode/agentcore-repro/repo
	directory = /var/folders/h9/057c6v717j975wpgy_gnh_500000gn/T/opencode/agentcore-repro/bp
	directory = /var/folders/h9/057c6v717j975wpgy_gnh_500000gn/T/opencode/task10-repro/repo
