// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "default_open_behavior": "existing_window",
  "cli_default_open_behavior": "existing_window",
  "bottom_dock_layout": "full",
  "edit_predictions": {
    "provider": "zed"
  },
  "icon_theme": {
    "mode": "dark",
    "light": "Zed (Default)",
    "dark": "Catppuccin Mocha"
  },
  "project_panel": {
    "dock": "right"
  },
  "outline_panel": {
    "dock": "right"
  },
  "collaboration_panel": {
    "dock": "right"
  },
  "git_panel": {
    "tree_view": true,
    "dock": "right"
  },
  "agent_servers": {
    "OpenCode": {
      "default_config_options": {
        "mode": "Build",
        "effort": "high",
        "model": "bedrock-mantle/gpt-6-sol"
      },
      "command": "/Users/psharma/.opencode/bin/opencode",
      "type": "custom",
      "args": ["acp"],
    },
  },
  "agent": {
    "flexible": true,
    "dock": "left",
    "default_model": {
      "provider": "openai",
      "model": "gpt-4o",
    },
    "model_parameters": [],
  },
  "terminal": {
    "dock": "bottom",
    "font_family": "Hack Nerd Font Mono",
    "font_size": 17,
    "line_height": "standard",
  },
  "telemetry": {
    "diagnostics": true,
    "metrics": false,
  },
  "base_keymap": "JetBrains",
  "ui_font_size": 17,
  "agent_ui_font_family": "Hack Nerd Font Mono",
  "agent_ui_font_size": 17,
  "agent_buffer_font_family": "Hack Nerd Font Mono",
  "agent_buffer_font_size": 17,
  "buffer_font_family": "Hack Nerd Font Mono",
  "buffer_font_size": 17,
  "theme": {
    "mode": "dark",
    "light": "Catppuccin Espresso (Blur)",
    "dark": "Gruvbox Dark",
  },
  "theme_overrides": {
    "Catppuccin Mocha (Blur)": {
      "text.placeholder": "#a6adc8",
      "icon.muted": "#a6adc8",
      "icon.placeholder": "#bac2de",
      "editor.background": "#45475a55",
      "tab_bar.background": "#45475a55",
      "panel.background": "#11111ba8",
      "terminal.background": "#11111ba8",
      "editor.line_number": "#a6adc8",
      "editor.active_line_number": "#f5e0dc",
      "editor.active_line.background": "#cba6f711",
      "editor.indent_guide": "#6c708699",
      "editor.indent_guide_active": "#b4befe",
      "panel.indent_guide": "#6c708699",
      "panel.indent_guide_active": "#b4befe",
      "border": "#6c708680",
      "border.variant": "#6c708660",
      "pane_group.border": "#6c708680",
      "pane.focused_border": "#b4befe80",
      "panel.focused_border": "#b4befe80"
    },
    "Gruvbox Dark": {
      "background.appearance": "blurred",
      "background": "#282828d0",
      "title_bar.background": "#282828d0",
      "status_bar.background": "#282828d0",
      "toolbar.background": "#00000000",
      "editor.background": "#50494566",
      "editor.gutter.background": "#00000000",
      "tab_bar.background": "#50494566",
      "tab.inactive_background": "#00000000",
      "tab.active_background": "#3c3836b0",
      "panel.background": "#1d2021a8",
      "terminal.background": "#1d2021a8",
      "text.placeholder": "#c5b597",
      "icon.muted": "#c5b597",
      "icon.placeholder": "#c5b597",
      "editor.line_number": "#a89984",
      "editor.active_line_number": "#fbf1c7",
      "editor.active_line.background": "#fabd2f12",
      "editor.indent_guide": "#7c6f6488",
      "editor.indent_guide_active": "#d79921",
      "panel.indent_guide": "#7c6f6488",
      "panel.indent_guide_active": "#d79921",
      "border": "#a8998466",
      "border.variant": "#a899844d",
      "pane_group.border": "#a8998466",
      "pane.focused_border": "#83a598aa",
      "panel.focused_border": "#83a598aa"
    }
  },
}
